#!/bin/sh
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1
if command -v py >/dev/null 2>&1; then
    exec py -3 tools/secret_scan.py "$1"
elif command -v python3 >/dev/null 2>&1; then
    exec python3 tools/secret_scan.py "$1"
elif command -v python >/dev/null 2>&1; then
    exec python tools/secret_scan.py "$1"
fi
printf '%s\n' 'Python 3 is required for the local secret guard; Git operation blocked.' >&2
exit 1
